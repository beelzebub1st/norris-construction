# Neon Postgres (from `neon deploy` / `neon env pull`)
# DATABASE_URL = pooled (app runtime)
# DATABASE_URL_UNPOOLED = direct (migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

NEXT_PUBLIC_SITE_URL=https://norrisconstruction.co
SITE_URL=https://norrisconstruction.co

ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-32-chars-minimum-secret

# Resend — verify domain norrisconstruction.co, then use a from-address on that domain
RESEND_API_KEY=
RESEND_FROM=Norris Construction Corp <Info@norrisconstruction.co>
LEAD_NOTIFY_EMAIL=Info@norrisconstruction.co
CRON_SECRET=change-me
